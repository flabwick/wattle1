// Wattle data model — see spec1.md Part 2 (Pages/Cards) and Part 4 (stable IDs +
// last-modified timestamps "even though MVP doesn't need conflict resolution yet",
// so a future sync/offline layer doesn't require a schema rewrite).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A Card in the vault — the flat, searchable list from spec1.md Part 3 "Vault".
model Card {
  id        String   @id @default(cuid())
  title     String
  content   String   @default("")
  /// Versioned, extensible per-Card data (links, summary, color, aiParams, log, ...)
  /// — see packages/shared/src/registries/cardMetadata.ts. Additive: new fields go in
  /// a new metadata version, not a new column. Stored as a JSON string, not Prisma's
  /// `Json` scalar, because the sqlite connector doesn't support that scalar type;
  /// serialization happens in cardService.ts (serializeCard / write paths).
  metadata  String   @default("{}")
  /// Whether this Card independently exists in the Vault (searchable/listable there),
  /// or is still page-local scratch content. A Card created straight in the vault
  /// (createCard) is saved from the start; one created inside a Page (addNewCardToPage)
  /// or by a generation (generateFromCard) starts false and only flips true when its
  /// Page's Save action runs (pageCardService.saveToVault) — spec1.md Part 3's staging
  /// layer "between 'in context' and 'in the vault'", made explicit as a real flag
  /// rather than just PageCard's draft fields.
  savedToVault Boolean @default(true)
  /// Null while Open (editable in place — the default). Set to the freeze time once
  /// Frozen: read-only, safe as stable context to link/embed against. Editing a
  /// Frozen Card never mutates it — see forkedFromId below and
  /// cardService.ts's freezeCard/forkCard.
  frozenAt DateTime?
  /// Set only on a Card created by forking a Frozen Card (cardService.ts's
  /// forkCard) — points at the Frozen original it was copied from, for lineage
  /// display and so proximityService can record a strong durable tie between them.
  /// Not cascaded on delete: losing the original shouldn't take the fork down too.
  forkedFromId String?
  forkedFrom   Card?    @relation("CardFork", fields: [forkedFromId], references: [id])
  forks        Card[]   @relation("CardFork")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pageCards PageCard[]
  dockCards DockCard[]
  /// This Card is a "stack"-typed container for these StackMembers — see
  /// registries/definitions/stackCardType.ts and stackService.ts.
  stackMembers StackMember[] @relation("StackContainer")
  /// This Card is the alternate content of a StackMember belonging to some other
  /// (container) Card — the other side of the same relation.
  memberOfStack StackMember? @relation("StackMemberCard")
  /// This Card's durable Nearby ties (proximityService.ts) — one row per unordered
  /// pair this Card participates in, as either side.
  proximityAsA CardProximity[] @relation("ProximityCardA")
  proximityAsB CardProximity[] @relation("ProximityCardB")
}

/// A durable Nearby tie between two Cards (Wattle vault plan's "durable map") —
/// reinforced by Page co-presence, embeds/links, and forks (proximityService.ts),
/// decaying with disuse at read time so old, unused ties don't dominate forever.
/// One row per unordered pair: `cardAId` is always the lexicographically smaller id,
/// so a pair is looked up/upserted unambiguously regardless of which Card triggered
/// the reinforcement.
model CardProximity {
  id               String   @id @default(cuid())
  cardAId          String
  cardBId          String
  score            Float    @default(0)
  lastReinforcedAt DateTime @updatedAt
  createdAt        DateTime @default(now())

  cardA Card @relation("ProximityCardA", fields: [cardAId], references: [id], onDelete: Cascade)
  cardB Card @relation("ProximityCardB", fields: [cardBId], references: [id], onDelete: Cascade)

  @@unique([cardAId, cardBId])
  @@index([cardAId])
  @@index([cardBId])
}

/// A Tab — vestigial (Pages + Links + Search rebuild): retained only so pre-rebuild
/// Pages keep a working `tabId` foreign key until the one-time hub migration
/// (scripts/migrateTabsToHubs.ts) has run against a given database. No route, service,
/// or UI creates, lists, or navigates by Tab any more — a Tab is not a user-facing
/// place. Safe to drop entirely (and make Page.tabId non-nullable-never-set) once every
/// deployment has migrated.
model Tab {
  id        String   @id @default(cuid())
  order     Int
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pages Page[]
}

/// A Page — a destination you go to (Pages + Links + Search rebuild's locked primitive).
/// Loose/unlinked Pages are fine; "claimed" just means named and/or linked from Home
/// (or pinned) — there is no separate schema flag for that, it's derived from `title`/
/// pinnedOrder/inbound PageLinks.
model Page {
  id        String   @id @default(cuid())
  /// Display name shown as the Page's destination identity. Null is a valid, common
  /// state — an untitled/loose scratch Page never forces the user to name it.
  title     String?
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Vestigial — see the Tab model's own doc comment. Nullable so every newly created
  /// Page (Phase 1 onward) never needs one; only pre-migration Pages still carry a
  /// value here.
  tabId String?
  tab   Tab?   @relation(fields: [tabId], references: [id], onDelete: Cascade)

  /// Groups a set of Pages that used to be one Tab's vertical stack (or, going
  /// forward, any Pages explicitly kept as a "next/prev" trail) — the Tab-collapse
  /// migration's hub-Page-plus-links is the primary UI for this now; `orderInGroup`
  /// only powers the optional sibling next/prev polish (see Phase 3 of the rebuild
  /// plan), never primary navigation.
  siblingGroupId String?
  orderInGroup   Int?

  /// Non-null places this Page in the scarce pin rail, in ascending display order.
  /// Null (the default/common case) means not pinned.
  pinnedOrder Int?

  pageCards    PageCard[]
  homeSettings UserSettings[]  @relation("HomePage")
  linksOut     PageLink[]      @relation("LinkSource")
  linksIn      PageLink[]      @relation("LinkTarget")

  @@index([tabId])
  @@index([siblingGroupId])
  @@index([title])
}

/// A Page -> Page navigation link (Pages + Links + Search rebuild's "Link" primitive) —
/// distinct from a Card embed (`<wattle-embed>`) and from an external URL: this is the
/// wiki-style destination-to-destination edge that Search/Home/hub Pages are built out
/// of. `sourcePageId` is the Page whose rich text contains the link mark; `targetPageId`
/// is what it points at. One row per (source, target) *and* per occurrence isn't
/// tracked — the mark itself lives inline in the source Page's Card content (via a
/// PageCard), this row only exists so "orphan"/"inbound links" queries don't need to
/// scan and parse every Card's rich text.
model PageLink {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  sourcePageId String
  sourcePage   Page   @relation("LinkSource", fields: [sourcePageId], references: [id], onDelete: Cascade)
  targetPageId String
  targetPage   Page   @relation("LinkTarget", fields: [targetPageId], references: [id], onDelete: Cascade)

  @@unique([sourcePageId, targetPageId])
  @@index([targetPageId])
}

/// Single-row app-wide preferences — Home and pins live here rather than as a Page
/// flag, so "which Page is Home" is one obvious answer instead of schema sprawl
/// (multiple Pages fighting over an `isHome` boolean). Always exactly one row, with
/// the fixed id "singleton" — see api/src/services/settingsService.ts.
model UserSettings {
  id String @id

  homePageId String?
  homePage   Page?   @relation("HomePage", fields: [homePageId], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt
}

/// A Card living outside any Page/Tab — the persistent Dock scratchpad layer from the
/// Step 6 spec. Never part of generation context. `order` positions it in the Dock's
/// horizontal scroll row.
model DockCard {
  id        String   @id @default(cuid())
  cardId    String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

/// One alternate held by a "stack"-typed Card (registries/definitions/stackCardType.ts)
/// — the Stack's own counterpart to PageCard: `cardId` is a real, freshly-created Card
/// holding this alternate's title/content, draftTitle/draftContent stage unsaved edits
/// the same way PageCard's do, and only the alternate at the container Card's own
/// `metadata.stack.activeIndex` (cardMetadata.ts) is "in" the page at a time — see
/// stackService.ts. `cardId` is unique because each alternate gets its own
/// purpose-created Card, never a Card shared with another StackMember or PageCard.
model StackMember {
  id          String   @id @default(cuid())
  stackCardId String
  cardId      String   @unique
  order       Int

  draftTitle   String?
  draftContent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stackCard Card @relation("StackContainer", fields: [stackCardId], references: [id], onDelete: Cascade)
  card      Card @relation("StackMemberCard", fields: [cardId], references: [id], onDelete: Cascade)

  @@index([stackCardId])
}

/// A reusable Tab or Page template — see
/// packages/shared/src/registries/templateSnapshot.ts for the versioned
/// `TemplateSnapshotV1` payload stored in `snapshot`. Core Templates (`isCore`) are
/// seeded by prisma/seed.ts and are read-only from the API's perspective
/// (templateService.ts rejects update/delete against them regardless of what the
/// frontend allows).
model Template {
  id          String   @id @default(cuid())
  /// Stable lookup key for core Templates ("blank", "note", "chat"); user-created
  /// Templates leave this null since they have no need for a fixed identity.
  slug        String?  @unique
  name        String
  description String?
  /// Whether `snapshot` reconstructs a whole Tab (ordered Pages of ordered Cards) or a
  /// single Page (ordered Cards) — see TemplateSnapshotV1.
  scope       String
  isCore      Boolean  @default(false)
  sortOrder   Int      @default(0)
  /// Versioned JSON payload (TemplateSnapshotV1), stored as a JSON string for the
  /// same reason as Card.metadata: the sqlite connector doesn't support Prisma's
  /// `Json` scalar. Never built from or trusted as browser input — always
  /// serialized server-side from real Tab/Page/Card data at save time
  /// (templateService.ts).
  snapshot    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// A Card's placement within a Page, including any unsaved draft edits.
model PageCard {
  id        String   @id @default(cuid())
  pageId    String
  cardId    String
  order     Int

  draftTitle   String?
  draftContent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@index([cardId])
}
