// Wattle data model — see spec1.md Part 2 (Pages/Cards) and Part 4 (stable IDs +
// last-modified timestamps "even though MVP doesn't need conflict resolution yet",
// so a future sync/offline layer doesn't require a schema rewrite).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A Card in the vault — the flat, searchable list from spec1.md Part 3 "Vault".
model Card {
  id        String   @id @default(cuid())
  title     String
  content   String   @default("")
  /// Versioned, extensible per-Card data (links, summary, color, aiParams, log, ...)
  /// — see packages/shared/src/registries/cardMetadata.ts. Additive: new fields go in
  /// a new metadata version, not a new column. Stored as a JSON string, not Prisma's
  /// `Json` scalar, because the sqlite connector doesn't support that scalar type;
  /// serialization happens in cardService.ts (serializeCard / write paths).
  metadata  String   @default("{}")
  /// Whether this Card independently exists in the Vault (searchable/listable there),
  /// or is still page-local scratch content. A Card created straight in the vault
  /// (createCard) is saved from the start; one created inside a Page (addNewCardToPage)
  /// or by a generation (generateFromCard) starts false and only flips true when its
  /// Page's Save action runs (pageCardService.saveToVault) — spec1.md Part 3's staging
  /// layer "between 'in context' and 'in the vault'", made explicit as a real flag
  /// rather than just PageCard's draft fields.
  savedToVault Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Which vault Folder this Card sits in — null means the vault root. Set only once
  /// savedToVault; page-local scratch Cards aren't placed in the tree yet.
  folderId String?
  folder   Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)

  pageCards PageCard[]
  dockCards DockCard[]
  /// This Card is a "stack"-typed container for these StackMembers — see
  /// registries/definitions/stackCardType.ts and stackService.ts.
  stackMembers StackMember[] @relation("StackContainer")
  /// This Card is the alternate content of a StackMember belonging to some other
  /// (container) Card — the other side of the same relation.
  memberOfStack StackMember? @relation("StackMemberCard")

  @@index([folderId])
}

/// A Folder in the vault — groups Cards and other Folders into a navigable tree.
/// spec1.md's original Vault section explicitly deferred this ("no folders ... yet");
/// this is that deferred feature. `parentId` null means the folder sits at vault root.
/// Deleting a Folder cascades to its Cards and to its subfolders (and *their* Cards),
/// recursively — a deliberate product choice, not an oversight.
model Folder {
  id        String   @id @default(cuid())
  title     String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Folder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("FolderChildren")
  cards    Card[]

  @@index([parentId])
}

/// A Tab — a horizontal slot holding its own independent stack of Pages. Tabs do not
/// share generation context with each other (see Step 6 spec, "Interaction Overhaul").
model Tab {
  id        String   @id @default(cuid())
  order     Int
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pages Page[]
}

/// A Page — one slot in the vertical stack. `order` is ascending bottom (0) to top,
/// scoped within its parent Tab.
model Page {
  id        String   @id @default(cuid())
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tabId String
  tab   Tab    @relation(fields: [tabId], references: [id], onDelete: Cascade)

  pageCards PageCard[]

  @@index([tabId])
}

/// A Card living outside any Page/Tab — the persistent Dock scratchpad layer from the
/// Step 6 spec. Never part of generation context. `order` positions it in the Dock's
/// horizontal scroll row.
model DockCard {
  id        String   @id @default(cuid())
  cardId    String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

/// One alternate held by a "stack"-typed Card (registries/definitions/stackCardType.ts)
/// — the Stack's own counterpart to PageCard: `cardId` is a real, freshly-created Card
/// holding this alternate's title/content, draftTitle/draftContent stage unsaved edits
/// the same way PageCard's do, and only the alternate at the container Card's own
/// `metadata.stack.activeIndex` (cardMetadata.ts) is "in" the page at a time — see
/// stackService.ts. `cardId` is unique because each alternate gets its own
/// purpose-created Card, never a Card shared with another StackMember or PageCard.
model StackMember {
  id          String   @id @default(cuid())
  stackCardId String
  cardId      String   @unique
  order       Int

  draftTitle   String?
  draftContent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stackCard Card @relation("StackContainer", fields: [stackCardId], references: [id], onDelete: Cascade)
  card      Card @relation("StackMemberCard", fields: [cardId], references: [id], onDelete: Cascade)

  @@index([stackCardId])
}

/// A reusable Tab or Page template — see packages/shared/src/registries/appSnapshot.ts
/// for the versioned `AppSnapshotV1` payload stored in `snapshot`. Core Apps (`isCore`)
/// are seeded by prisma/seed.ts and are read-only from the API's perspective (appService.ts
/// rejects update/delete against them regardless of what the frontend allows).
model App {
  id          String   @id @default(cuid())
  /// Stable lookup key for core Apps ("blank", "note", "chat"); user-created Apps leave
  /// this null since they have no need for a fixed identity.
  slug        String?  @unique
  name        String
  description String?
  /// Whether `snapshot` reconstructs a whole Tab (ordered Pages of ordered Cards) or a
  /// single Page (ordered Cards) — see AppSnapshotV1.
  scope       String
  isCore      Boolean  @default(false)
  sortOrder   Int      @default(0)
  /// Versioned JSON payload (AppSnapshotV1), stored as a JSON string for the same reason
  /// as Card.metadata: the sqlite connector doesn't support Prisma's `Json` scalar. Never
  /// built from or trusted as browser input — always serialized server-side from real
  /// Tab/Page/Card data at save time (appService.ts).
  snapshot    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// A Card's placement within a Page, including any unsaved draft edits.
model PageCard {
  id        String   @id @default(cuid())
  pageId    String
  cardId    String
  order     Int

  draftTitle   String?
  draftContent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@index([cardId])
}
