DATABASE_URL="file:./dev.db"
PORT=4000

# Plug in a real provider key when wiring generationService.ts up to an actual model call.
ANTHROPIC_API_KEY=

# OpenRouter is the centralized model backend (packages/prompt-engine/src/providers/
# openRouterProvider.ts). Setting this switches activeProviderId() to "openrouter".
OPENROUTER_API_KEY=
# Registry id from packages/prompt-engine/src/models/ (e.g. "claude-sonnet",
# "gpt-4o-mini") — not a raw OpenRouter "vendor/model" string. Defaults to
# "claude-sonnet" if unset.
MODEL_ID=

# Tavily (https://app.tavily.com) — powers the "search" CardType's Web mode (see
# src/services/webSearchService.ts). Leave blank to keep Web search showing "not
# set up yet"; nothing else in the app depends on it.
TAVILY_API_KEY=
